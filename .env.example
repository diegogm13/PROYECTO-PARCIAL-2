# Copiar a .env en la EC2 (cp .env.example .env) y cambiar TODAS las contraseñas.
# .env nunca se sube al repositorio.

# Levanta también OpenObserve, OTel Collector, Prometheus, Grafana y node-exporter
COMPOSE_PROFILES=monitoring
ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=sa
POSTGRES_USER=sa
POSTGRES_PASSWORD=cambiar_password_postgres

# Backend
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria_de_al_menos_32_caracteres
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sa.com
ADMIN_PASSWORD=Admin123!

# El backend envía logs, métricas y trazas al collector (que reenvía a OpenObserve)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# OpenObserve (usuario root; también lo usa el pipeline -> secrets OPENOBSERVE_*)
OPENOBSERVE_USER=admin@sa.com
OPENOBSERVE_PASSWORD=cambiar_password_openobserve

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambiar_password_grafana
